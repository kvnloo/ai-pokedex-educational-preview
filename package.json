{
  "name": "twilight-route",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "3D creature-collector demo — Pokémon mechanics, Twilight Wings presentation bar. Zero binary Nintendo assets.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4180 --strictPort",
    "typecheck": "tsc --noEmit",
    "test:battle": "node --experimental-strip-types tools/battle-golden.mjs",
    "content:sync": "node tools/pokeapi-sync.mjs",
    "content:sync:smoke": "node tools/pokeapi-sync.mjs --max 20",
    "verify": "npm run typecheck && npm run test:battle && npm run test:playtest && npm run build",
    "test:playtest": "node tools/playtest.mjs"
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/three": "^0.185.1",
    "typescript": "^5.8.2",
    "vite": "^6.2.0"
  }
}
