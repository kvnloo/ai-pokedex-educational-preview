; Synthetic native renderer/client preflight only.
; Gameplay/world/battle authority remains in shared engine-neutral contracts.
config_version=5

[application]
config/name="Pokemon Native Contract Preflight"
run/main_scene="res://scenes/preflight.tscn"

[display]
window/size/viewport_width=960
window/size/viewport_height=540
window/size/window_width_override=960
window/size/window_height_override=540
window/stretch/mode="canvas_items"
window/vsync/vsync_mode=0

[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="forward_plus"
rendering_device/driver="vulkan"
textures/default_filters/use_nearest_mipmap_filter=false

[environment]
defaults/default_clear_color=Color(0.008, 0.014, 0.03, 1)
