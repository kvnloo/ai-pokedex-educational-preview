{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "graph.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "graphId", "nodes"],
  "properties": { "schemaVersion": { "const": 1 }, "graphId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$" }, "nodes": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["id", "recipe", "dependsOn"], "properties": { "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$" }, "recipe": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$" }, "dependsOn": { "type": "array", "uniqueItems": true, "items": { "type": "string" } } } } } }
}
