{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sources"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } }
  },
  "$defs": {
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["sourceId", "owner", "classification", "locator", "expectedSha256", "expectedBytes", "adapter", "adapterVersion", "acquiredAt", "terms", "policy", "credentials", "offlineCache", "drift", "takedown"],
      "properties": {
        "sourceId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$" },
        "owner": { "type": "string", "minLength": 1 },
        "classification": { "enum": ["owner-supplied", "repository-original", "authorized-public"] },
        "locator": { "type": "string", "minLength": 1 },
        "expectedSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "expectedBytes": { "type": "integer", "minimum": 1 },
        "adapter": { "type": "string", "minLength": 1 },
        "adapterVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "acquiredAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "terms": { "type": "object", "additionalProperties": false, "required": ["snapshot", "sha256"], "properties": { "snapshot": { "type": "string", "minLength": 1 }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } },
        "policy": { "enum": ["private-only", "distributable"] },
        "credentials": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" }, "uniqueItems": true },
        "offlineCache": { "enum": ["required", "allowed", "forbidden"] },
        "drift": { "const": "fail" },
        "takedown": { "type": "string", "minLength": 1 }
      }
    }
  }
}
