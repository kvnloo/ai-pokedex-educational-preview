{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://twilight-route.local/schemas/client-asset-manifest-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profile", "assets"],
  "properties": {
    "schemaVersion": {"const": 1},
    "profile": {"enum": ["distributable", "private-local"]},
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assetId", "classification", "loadable", "privateOnly", "formats"],
        "properties": {
          "assetId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$"},
          "classification": {"type": "string", "minLength": 1},
          "loadable": {"type": "boolean"},
          "privateOnly": {"type": "boolean"},
          "formats": {
            "type": "object",
            "additionalProperties": false,
            "required": ["glb", "ktx2", "animations", "materials"],
            "properties": {
              "glb": {"type": "array"},
              "ktx2": {"type": "array"},
              "animations": {"type": "array"},
              "materials": {"type": "array"}
            }
          }
        }
      }
    }
  }
}
