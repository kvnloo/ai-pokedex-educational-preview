{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "lock.schema.json",
  "type": "object", "additionalProperties": false, "required": ["schemaVersion", "kind", "entries"],
  "properties": { "schemaVersion": { "const": 1 }, "kind": { "enum": ["tools", "models", "containers"] }, "entries": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["id", "version", "digest", "locator"], "properties": { "id": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 }, "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }, "locator": { "type": "string", "minLength": 1 } } } } }
}
