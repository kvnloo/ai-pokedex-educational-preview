{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "profile.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "profile", "privateStorageRequired", "allowedPolicies", "outputNamespace", "leakScan"],
  "properties": { "schemaVersion": { "const": 1 }, "profile": { "enum": ["private-local", "distributable"] }, "privateStorageRequired": { "type": "boolean" }, "allowedPolicies": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["private-only", "distributable"] } }, "outputNamespace": { "type": "string", "pattern": "^[a-z-]+$" }, "leakScan": { "const": true } }
}
