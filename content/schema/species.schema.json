{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://twilight-route.local/schema/species.schema.json",
  "title": "Species",
  "type": "object",
  "required": [
    "nationalId", "slug", "name", "types", "baseStats",
    "captureRate", "baseHappiness", "growthRate", "genderRate",
    "generation", "eggGroups", "abilities", "color", "shape",
    "isBaby", "isLegendary", "isMythical", "source"
  ],
  "additionalProperties": false,
  "properties": {
    "nationalId": { "type": "integer", "minimum": 1, "maximum": 2000 },
    "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string" },
    "types": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
    },
    "baseStats": {
      "type": "object",
      "required": ["hp", "atk", "def", "spa", "spd", "spe"],
      "additionalProperties": false,
      "properties": {
        "hp":  { "type": "integer", "minimum": 1, "maximum": 255 },
        "atk": { "type": "integer", "minimum": 1, "maximum": 255 },
        "def": { "type": "integer", "minimum": 1, "maximum": 255 },
        "spa": { "type": "integer", "minimum": 1, "maximum": 255 },
        "spd": { "type": "integer", "minimum": 1, "maximum": 255 },
        "spe": { "type": "integer", "minimum": 1, "maximum": 255 }
      }
    },
    "captureRate": { "type": "integer", "minimum": 0, "maximum": 255 },
    "baseHappiness": { "type": "integer", "minimum": 0, "maximum": 255 },
    "growthRate": { "type": "string" },
    "genderRate": {
      "type": "integer",
      "minimum": -1,
      "maximum": 8,
      "description": "PokéAPI gender_rate: -1 genderless, else eighths female"
    },
    "generation": { "type": "integer", "minimum": 1, "maximum": 16 },
    "eggGroups": { "type": "array", "items": { "type": "string" } },
    "abilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slug", "slot", "isHidden"],
        "additionalProperties": false,
        "properties": {
          "slug": { "type": "string" },
          "slot": { "type": "integer", "minimum": 1, "maximum": 3 },
          "isHidden": { "type": "boolean" }
        }
      }
    },
    "color": { "type": "string" },
    "shape": { "type": "string" },
    "habitat": { "type": ["string", "null"] },
    "heightM": { "type": "number", "minimum": 0 },
    "weightKg": { "type": "number", "minimum": 0 },
    "baseExperience": { "type": ["integer", "null"] },
    "isBaby": { "type": "boolean" },
    "isLegendary": { "type": "boolean" },
    "isMythical": { "type": "boolean" },
    "evolvesFromId": { "type": ["integer", "null"] },
    "flavor": { "type": "string" },
    "genus": { "type": "string" },
    "source": {
      "type": "object",
      "required": ["system", "syncedAt"],
      "properties": {
        "system": { "type": "string" },
        "syncedAt": { "type": "string" },
        "pokemonUrl": { "type": "string" },
        "speciesUrl": { "type": "string" }
      }
    }
  }
}
